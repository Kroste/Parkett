<views:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Parkett.Views"
        xmlns:controls="using:Parkett.Controls"
        xmlns:vm="using:Parkett.ViewModels"
        xmlns:loc="using:Parkett.Localization"
        x:Class="Parkett.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1240" Height="800"
        MinWidth="1000" MinHeight="640"
        Title="Parkett"
        Background="{DynamicResource KrosteBackgroundBrush}">

    <DockPanel>
        <controls:TitleBar DockPanel.Dock="Top" Title="Parkett" />

        <!-- Statuszeile: Datenquelle und Verzögerung sind Auflage praktisch jeder Datenlizenz -->
        <Border DockPanel.Dock="Bottom"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource KrosteBorderBrush}"
                Background="{DynamicResource KrosteTitleBarBrush}"
                Padding="16,7">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" Classes="secondary" FontSize="12"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding DisclaimerText}" Classes="muted" FontSize="11" Margin="16,0" />
                <TextBlock Grid.Column="2" Text="{Binding DataSourceText}" Classes="muted" FontSize="12" Margin="0,0,16,0" />
                <TextBlock Grid.Column="3" Text="{Binding EditionText}" Classes="muted" FontSize="12" />
            </Grid>
        </Border>

        <Grid Margin="18" ColumnDefinitions="*,18,340">

            <!-- ============ Linke Spalte: Chart und Transportleiste ============ -->
            <DockPanel Grid.Column="0">

                <!-- Kopfzeile über dem Chart -->
                <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Parkett" Classes="h1" />
                        <TextBlock Text="{Binding QuoteText}" Classes="secondary" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{loc:Tr Main_TradingDay}" Classes="muted" FontSize="12" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding DateText}" Classes="h2" HorizontalAlignment="Right" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Classes="ghost" Content="⚙" FontSize="15" Padding="10,6"
                                    ToolTip.Tip="{loc:Tr Common_Settings}"
                                    Click="OnOpenSettings" />
                            <Button Classes="ghost" Content="ⓘ" FontSize="15" Padding="10,6"
                                    ToolTip.Tip="{loc:Tr Window_About}"
                                    Click="OnOpenAbout" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Transportleiste -->
                <Border DockPanel.Dock="Bottom" Classes="card" Margin="0,12,0,0">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,16,Auto,Auto,16,*">
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding Instruments}"
                                  SelectedItem="{Binding SelectedInstrument}"
                                  MinWidth="150"
                                  VerticalAlignment="Center" />
                        <Button Grid.Column="1" Margin="8,0,0,0"
                                Content="{loc:Tr Transport_NewSession}"
                                Command="{Binding StartSessionCommand}" />
                        <Button Grid.Column="2" Classes="ghost" Margin="8,0,0,0"
                                Content="{loc:Tr Transport_Resume}"
                                IsVisible="{Binding HasSavedSession}"
                                Command="{Binding ResumeSessionCommand}" />

                        <Button Grid.Column="4" Classes="accent"
                                Content="{Binding PlayButtonText}"
                                MinWidth="96"
                                Command="{Binding TogglePlayCommand}" />
                        <Button Grid.Column="5" Classes="ghost" Margin="8,0,0,0"
                                Content="{loc:Tr Transport_Step}"
                                Command="{Binding StepCommand}" />

                        <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="10"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Tr Transport_Speed}" Classes="muted" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding Speeds}"
                                      SelectedItem="{Binding SelectedSpeed}"
                                      MinWidth="96"
                                      VerticalAlignment="Center" />
                            <ProgressBar Value="{Binding Progress}" Maximum="1" Width="140"
                                         VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Chart -->
                <Border Classes="card-flat">
                    <controls:CandlestickChart Margin="12"
                                               Candles="{Binding ChartCandles}"
                                               Markers="{Binding ChartMarkers}"
                                               UpBrush="{DynamicResource KrosteSuccessBrush}"
                                               DownBrush="{DynamicResource KrosteDangerBrush}"
                                               GridBrush="{DynamicResource KrosteBorderBrush}"
                                               LabelBrush="{DynamicResource KrosteMutedTextBrush}"
                                               CrosshairBrush="{DynamicResource KrosteGoldBrush}" />
                </Border>
            </DockPanel>

            <!-- ============ Rechte Spalte: Depot, Order, Bücher ============ -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14">

                    <Border Classes="card">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{loc:Tr Portfolio_Section}" Classes="section-label" />
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="1">
                                    <TextBlock Text="{loc:Tr Portfolio_Equity}" Classes="muted" FontSize="11" />
                                    <TextBlock Text="{Binding EquityText}" Classes="h2" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="1">
                                    <TextBlock Text="{loc:Tr Portfolio_Return}" Classes="muted" FontSize="11" />
                                    <TextBlock Text="{Binding ReturnText}" Classes="h2" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="1" Margin="0,10,0,0">
                                    <TextBlock Text="{loc:Tr Portfolio_Cash}" Classes="muted" FontSize="11" />
                                    <TextBlock Text="{Binding CashText}" Classes="secondary" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="1" Margin="0,10,0,0">
                                    <TextBlock Text="{loc:Tr Portfolio_Fees}" Classes="muted" FontSize="11" />
                                    <TextBlock Text="{Binding FeeText}"
                                               Foreground="{DynamicResource KrosteGoldBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Spacing="1" Margin="0,10,0,0">
                                    <TextBlock Text="{loc:Tr Portfolio_Position}" Classes="muted" FontSize="11" />
                                    <TextBlock Text="{Binding PositionText}" Classes="secondary" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{loc:Tr Order_Section}" Classes="section-label" />
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" >
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr Order_Quantity}" Classes="muted"
                                           VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Quantity}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Tr Order_Limit}" Classes="muted"
                                           VerticalAlignment="Center" Margin="0,8,10,0" />
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,8,0,0"
                                         Text="{Binding LimitPrice}"
                                         PlaceholderText="{loc:Tr Order_LimitHint}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Tr Order_Stop}" Classes="muted"
                                           VerticalAlignment="Center" Margin="0,8,10,0" />
                                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,8,0,0"
                                         Text="{Binding StopPrice}"
                                         PlaceholderText="{loc:Tr Order_StopHint}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,10,*">
                                <Button Grid.Column="0" Classes="accent" Content="{loc:Tr Order_Buy}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Command="{Binding BuyCommand}" />
                                <Button Grid.Column="2" Classes="danger" Content="{loc:Tr Order_Sell}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Command="{Binding SellCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="card" IsVisible="{Binding HasOpenOrders}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{loc:Tr Order_OpenSection}" Classes="section-label" />
                            <ItemsControl ItemsSource="{Binding OpenOrders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:OpenOrderRow">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                                            <TextBlock Grid.Column="0" Classes="secondary" FontSize="12">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} {1} {2} @ {3}">
                                                        <Binding Path="Side" />
                                                        <Binding Path="Quantity" />
                                                        <Binding Path="Symbol" />
                                                        <Binding Path="Trigger" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <Button Grid.Column="1" Classes="ghost" Content="✕"
                                                    Padding="8,2" FontSize="11"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).CancelOrderCommand}"
                                                    CommandParameter="{Binding Id}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Classes="card-flat" MinHeight="180">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{loc:Tr Order_Blotter}" Classes="section-label"
                                       Margin="16,14,16,8" />
                            <ListBox ItemsSource="{Binding Blotter}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="12"
                                     Margin="8,0,8,8" />
                        </DockPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</views:ChromeWindow>
