<views:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Parkett.Views"
        xmlns:controls="using:Parkett.Controls"
        xmlns:loc="using:Parkett.Localization"
        x:Class="Parkett.Views.UpdatePromptWindow"
        Width="420" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="{loc:Tr Window_Update}"
        Background="{DynamicResource KrosteBackgroundBrush}">
    <DockPanel>
        <controls:TitleBar DockPanel.Dock="Top" Title="{loc:Tr Window_Update}" />

        <StackPanel Margin="22" Spacing="14">
            <StackPanel Spacing="6">
                <TextBlock x:Name="Headline" Classes="h2" TextWrapping="Wrap" />
                <TextBlock x:Name="Body" Classes="secondary" TextWrapping="Wrap" FontSize="12" />
            </StackPanel>

            <ProgressBar x:Name="Progress" IsVisible="False" Minimum="0" Maximum="1" />
            <TextBlock x:Name="Status" Classes="muted" FontSize="11" IsVisible="False" />

            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button x:Name="LaterButton" Classes="ghost" Content="{loc:Tr Common_Later}" />
                <Button x:Name="InstallButton" Classes="accent" Content="{loc:Tr Update_Install}" />
            </StackPanel>
        </StackPanel>
    </DockPanel>
</views:ChromeWindow>
