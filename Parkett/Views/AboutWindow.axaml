<views:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Parkett.Views"
        xmlns:controls="using:Parkett.Controls"
        xmlns:loc="using:Parkett.Localization"
        x:Class="Parkett.Views.AboutWindow"
        Width="420" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="{loc:Tr Window_About}"
        Background="{DynamicResource KrosteBackgroundBrush}">
    <DockPanel>
        <controls:TitleBar DockPanel.Dock="Top" Title="{loc:Tr Window_About}" />
        <StackPanel Margin="24" Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Text="Parkett" Classes="h1" FontSize="22" />
                <TextBlock Text="{loc:Tr About_Tagline}"
                           Classes="secondary" TextWrapping="Wrap" />
                <TextBlock x:Name="VersionText" Classes="muted" FontSize="12" Margin="0,4,0,0" />
            </StackPanel>

            <Rectangle Classes="divider-h" />

            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="UpdateButton" Classes="accent" Content="{loc:Tr About_CheckUpdates}" />
                    <TextBlock x:Name="UpdateResult" VerticalAlignment="Center" Classes="secondary" />
                </StackPanel>

                <!-- Erscheint erst, wenn die Prüfung ein passendes Asset gefunden hat.
                     Ohne diesen Knopf wäre der Dialog eine reine Benachrichtigung — der
                     Kroste-Standard verlangt echtes Self-Update. -->
                <Button x:Name="InstallButton" Classes="accent"
                        Content="{loc:Tr Update_Install}" IsVisible="False"
                        HorizontalAlignment="Left" />
                <ProgressBar x:Name="UpdateProgress" IsVisible="False"
                             Minimum="0" Maximum="1" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="GithubButton" Content="GitHub" />
                <Button x:Name="BmcButton" Content="☕ Buy me a coffee" />
            </StackPanel>

            <TextBlock Text="{loc:Tr About_License}"
                       Classes="muted" FontSize="11" />
        </StackPanel>
    </DockPanel>
</views:ChromeWindow>
