<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <!-- Windows-only. Nicht entfernen — sonst leiden Fenster-Transparenz und die
       Einbettung von Standard-Windows-Controls (Combobox-Popups etc.).
       Details: https://learn.microsoft.com/en-us/windows/win32/sbscs/application-manifests -->
  <assemblyIdentity version="1.0.0.0" name="Parkett.Desktop"/>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 + 11 (dieselbe GUID gilt für beide). -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <!-- Per-Monitor-DPI-Awareness v2: Avalonia rendert damit scharf auf HiDPI-
       Displays und beim Umziehen zwischen Monitoren mit unterschiedlichem
       Skalierungsfaktor. Ohne den Eintrag wirkt die App auf 4K/HiDPI unter
       Windows blurry (System-DPI-Fallback des OS skaliert das Bitmap).
       longPathAware ist billige Absicherung gegen MAX_PATH-Ärger bei
       Nutzern mit tief verschachtelten Home-Verzeichnissen. -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
