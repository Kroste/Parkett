<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- xunit.v3 4.x + .NET-10-SDK: der alte VSTest-Pfad ist entfernt,
         "dotnet test" läuft nur noch über Microsoft.Testing.Platform. -->
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <!-- Notbremse gegen einen Test, der in einer allokierenden Endlosschleife
         hängt: der Lauf endet als OutOfMemoryException statt den Rechner (oder
         den CI-Runner) leerzuziehen. Portabel, greift auch unter Windows. -->
    <RuntimeHostConfigurationOption Include="System.GC.HeapHardLimit" Value="0x100000000" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Parkett/Parkett.csproj" />
  </ItemGroup>
</Project>
