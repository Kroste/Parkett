<Project>
  <!-- Central Package Management: EINZIGER Ort für Paketversionen.
       Stand: geprüft gegen NuGet beim Projektstart. -->
  <ItemGroup>
    <!-- Avalonia 12.1.1 (neueste stabile 12.x).
         DiagnosticsSupport folgt NICHT der Avalonia-Version (eigene 2.x-Reihe)! -->
    <PackageVersion Include="Avalonia" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <!-- Nur Debug-Builds referenzieren dieses Paket (DevTools) -->
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <!-- Linux DBus/Tray. Die Version folgt dem transitiven Zug von
         Avalonia.FreeDesktop 12.1.1 (= 0.94.1), NICHT der Höchstversion:
         0.95.0 existiert, gehört aber nicht zu dieser Avalonia-Linie.
         Der Verweis steht bewusst explizit in Parkett.csproj — ohne ihn wäre
         der Eintrag hier wirkungslos, weil CPM transitive Pakete nur mit
         CentralPackageTransitivePinningEnabled pinnt. -->
    <PackageVersion Include="Tmds.DBus.Protocol" Version="0.94.1" />

    <!-- MVVM & DI -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />

    <!-- Secret-Schutz: DPAPI unter Windows -->
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />

    <!-- Logging -->
    <PackageVersion Include="NLog" Version="6.2.0" />

    <!-- Versionierung -->
    <PackageVersion Include="MinVer" Version="7.0.0" />

    <!-- Tests (xunit.v3, NICHT das alte "xunit"-Paket — v2 ist deprecated);
         FluentAssertions NICHT auf 8.x heben (Xceed-Lizenz) -->
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <PackageVersion Include="FluentAssertions" Version="[7.2.2,8.0.0)" />
  </ItemGroup>
</Project>
